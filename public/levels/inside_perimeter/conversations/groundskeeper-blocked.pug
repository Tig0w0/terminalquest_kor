-
  const STATE_KEY = 'TQ_API_ACADEMY_WORLD_STATE';
  const worldState = getState(STATE_KEY);
  let allComplete = worldState.insideCatacombs.keySpellsObtained.length === 4 ? true : false;

mixin gauntlet
  response#gauntlet.
    기숙사 건틀릿은 어떤 시험인가요?

conversation(display_name="API 비전술 아카데미 관리인")
  case lastResponse

    when "gauntlet"
      statement#gauntlet

    default
      statement#default
      responses
        +gauntlet

  statements

    statement#default
      if allComplete
        text.
          정말 흥미롭군요! 곧 시작될 기숙사 건틀릿에 때맞춰 도착했습니다!
          안뜰을 지나 중앙 홀로 곧장 가세요. 기숙사 배정식에 쓸 기숙사의 불꽃을
          준비하고 있을 겁니다. 어느 기숙사에 들어가고 싶은지 생각해 두었기를
          바랍니다!

      else
        text.
          다시 만났군요, 오퍼레이터! 기숙사 건틀릿이 곧 시작되지만 아직 지하
          묘지의 목표를 모두 완료하지 않은 것 같습니다. 목표를 마치면 이 길을
          따라 중앙 홀로 가서 기숙사를 선택할 수 있습니다.

    statement#gauntlet
      text.
        기숙사 건틀릿(House Gauntlet)은 네 기숙사 구역에 마련된 고급 API 과제
        모음입니다. 러브레이스 탑, 호퍼 온실, 폰 노이만 연구소, 튜링 들판에서
        열리죠. 안뜰 너머 중앙 홀에서 각 구역으로 갈 수 있지만, 건틀릿 때문에
        일부 구역은 출입이 제한될 수도 있습니다.

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
