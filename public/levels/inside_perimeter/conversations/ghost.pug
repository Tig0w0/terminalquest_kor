-
  const STATE_KEY = 'TQ_API_ACADEMY_WORLD_STATE';
  const worldState = getState(STATE_KEY);
  let allComplete = worldState.insideCatacombs.keySpellsObtained.length === 4 ? true : false;

mixin personal_intro
  response#personal_intro.
    으악, 유령이다! 다시 한번 소개해 주시겠어요?

mixin catacombs_introduction
  response#catacombs_introduction.
    지하 묘지에서는 무엇을 해야 하나요?

mixin get_started
  response#get_started.
    앞에 놓인 도전에 맞서 아카데미에서 제 자리를 찾을 준비가 됐습니다.

mixin proceed
  response#proceed.
    다녀오겠습니다!

mixin pledge_scroll
  response#pledge_scroll.
    서약 두루마리를 받았습니다. 이제 무엇을 해야 하나요?

mixin houses
  response#houses.
    비전술 아카데미의 기숙사에 관해 더 알려 주시겠어요?

conversation(display_name="지하 묘지의 유령")
  case lastResponse
    when "houses"
      statement#houses
      responses
        +get_started
        +catacombs_introduction

    when "personal_intro"
      statement#personal_intro
      responses
        +get_started
        +catacombs_introduction
        +houses

    when "catacombs_introduction"
      statement#catacombs_introduction
      responses
        +get_started
        +personal_intro
        +houses

    when "proceed"
      statement#proceed

    when "ack"
      statement#ack
      responses
        +catacombs_introduction
        +personal_intro
        +houses

    when "help"
      statement#help
      responses
        +catacombs_introduction
        +houses

    when "pledge_scroll"
      statement#congratulations

    when "get_started"
      statement#get_started
      responses
        if worldState.insideCatacombs.hasCredentials
          +proceed
          +catacombs_introduction
          +personal_intro
          +houses
        else
          response#ack.
            알겠습니다. 지하 묘지로 계속 들어가기 전에 기사 석상에게 Twilio 인증 정보를 건네야겠군요.

    default
      if !worldState.insidePerimeter.ghost_introduction
        - worldState.insidePerimeter.ghost_introduction = true;
        statement#default
        responses
          +catacombs_introduction
          +get_started
          +houses

      else
        statement#follow_up_greeting
        responses
          if allComplete
            +pledge_scroll
            +personal_intro
            +houses
          else
            +catacombs_introduction
            response#help.
              과제를 완료하는 데 도움이 필요합니다.

  statements
    statement#default
      text.
        세상에, 지하 묘지에 손님이 찾아온 게 얼마 만인지 모르겠군요! 저는 해팁 레스타피 교수입니다. 해티 교수라고 불러도 좋아요.
        이 지하 묘지를 안내하고 앞으로 마주할 도전을 헤쳐 나가도록 도와드리겠습니다.<br><br>
        이곳의 도전은 API의 힘을 다루는 능력을 시험할 뿐 아니라 여러분의 마법이 어느 길과 맞는지도 알려 줄 겁니다.
        코드로 자신을 표현하는 길일까요? 코드로 문제를 해결하는 길? 코드 아래의 이론과 과학을 탐구하는 길?
        아니면 코드로 일상의 한계를 넓히는 길일까요?

    statement#houses
      text.
        기숙사마다 고유한 강점과 전문 분야가 있습니다.
        솔직히 말해 그 많은 활동을 제가 전부 따라가기는 어렵답니다.
        각 기숙사 구성원에게 직접 물어보는 편이 나을 거예요.

    statement#catacombs_introduction
      text.
       지하 묘지의 방들은 비전술 아카데미 네 기숙사의 상징 동물이 지키고 있습니다.
       각 방에서 새로운 과제에 맞서 능력을 증명해야 합니다.
       과제를 마칠 때마다 상징 동물이 <span class="highlight">해제 주문</span>의 한 조각을 줄 겁니다.
       네 조각을 모두 모으면 지하 묘지 중앙의 신성한 두루마리 방으로 들어갈 열쇠를 불러낼 수 있습니다.<BR><BR>
       그 열쇠로 방에 들어가 지금까지 익힌 마법이 깃든 서약 두루마리를 찾으세요.

    statement#get_started
      if worldState.insideCatacombs.hasCredentials
        text.
          Twilio 계정 인증 정보를 챙겨 왔으니 준비를 단단히 했군요.
          이제 지하 묘지로 들어가도 좋습니다. 행운을 빕니다, 오퍼레이터!
      else
        text.
          시작하기 전에 앞에 놓인 시련을 감당할 준비가 됐다는 것을 기사 석상에게 증명해야 합니다.
          계속 진행하려면 Twilio 인증 정보를 찾아 기사 석상에게 건네세요.

    statement#proceed
      text.
        행운을 빕니다! 도움이 필요하면 제게 돌아오세요.

    statement#follow_up_greeting
      if allComplete
        text.
          다시 만났군요, 오퍼레이터! 지하 묘지 여정은 잘 되어 가나요?

      else if worldState.insideCatacombs.keySpellsObtained.length === 0
        text.
          다시 만났군요, 오퍼레이터! 지하 묘지 여정은 잘 되어 가나요?
          아직 신성한 두루마리 방의 열쇠를 얻는 데 필요한 주문 조각을 하나도 맞추지 못한 것 같군요.

      else
        text.
          다시 만났군요, 오퍼레이터! 지하 묘지 여정은 잘 되어 가나요?
          신성한 두루마리 방의 열쇠를 얻는 데 필요한 주문 네 조각 중
          아직 #{worldState.insideCatacombs.keySpellsObtained.length}개만 맞춘 것 같군요.

    statement#congratulations
      text.
        잘했습니다! 이제 아카데미 지상에 있는 기숙사 책임자에게 서약 두루마리를 가져가
        정식으로 기숙사에 들어가야 합니다.<br><br>
        곧 기숙사 대항전이 열린다는군요.
        기숙사 대항전은 각 기숙사가 코드 실력을 겨루는 흥미진진한 대회입니다.
        진정한 비전술사로서 실력을 증명했으니 참가를 생각해 보세요!

    statement#ack
      text.
        궁극의 API 주문서인 <a href="https://twilio.com/console">Twilio Console</a>을 방문하세요.
        기사 석상이 요구하는 인증 정보를 그곳에서 찾을 수 있습니다.

    statement#help
      text.
        YouTube의 <a href="https://www.youtube.com/watch?v=GZvSYJDk-us">APIs for Beginners</a> 강좌를 확인해 보세요!

    statement#personal_intro
      text.
        저는 <span class="highlight">해팁 레스타피 교수</span>입니다. 해티 교수라고 불러도 좋아요.
        이 지하 묘지를 안내하고 앞으로 마주할 도전을 헤쳐 나가도록 도와드리는 일을 합니다.

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
