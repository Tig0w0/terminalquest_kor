-
  const STATE_KEY = 'TQ_HOUSE_CEREMONY_WORLD_STATE';
  const worldState = getState(STATE_KEY);
  const localizedHouseNames = { lovelace: '러브레이스', turing: '튜링', neumann: '폰 노이만', hopper: '호퍼' };

mixin unique
  response#unique.
    호퍼 기숙사만의 특징이 무엇이었는지 다시 알려 주시겠어요?

mixin join
  response#join.
    호퍼 기숙사에 들어가고 싶습니다!

mixin deciding
  response#deciding.
    어느 기숙사에 들어갈지 아직 고민 중입니다.

mixin getting_started
  response#getting_started.
    어서 시작하고 싶어요!

conversation(display_name="호퍼 기숙사 책임자 배링턴 교수")
  case lastResponse

    when "unique"
      statement#unique
      responses
        +join
        +deciding

    when "join"
      statement#join

    when "deciding"
      statement#deciding

    when "getting_started"
      statement#getting_started

    default
      if !worldState.playerHouse
        statement#default
        responses
          +unique
          +join
          +deciding

      else if worldState.playerHouse && !worldState.heapsortConversationHasEnded
        statement#history

      else if worldState.playerHouse && worldState.heapsortConversationHasEnded
        statement#gauntlet_default
        responses
          +getting_started

  statements
    statement#default
      text.
        아카데미에 들어오기로 했다니 정말 기쁩니다, 오퍼레이터!
        호퍼 기숙사에서도 여러분을 환영합니다.

    statement#unique
      text.
        호퍼 기숙사의 강점은 대담함과 새로운 API를 기꺼이 시도하는 자세입니다.

    statement#join
      text.
        훌륭합니다! 호퍼 기숙사에 오신 것을 진심으로 환영해요.
        선택을 확정하려면 서약 두루마리를 홀 중앙의 #[span.highlight 기숙사 불꽃]에 바치세요.

    statement#deciding
      text.
        천천히 생각하세요. 다만 선택을 확정하는 순간 기숙사 대항전이 시작된다는 점은 알아 두세요.
        아카데미에서도 손꼽히게 흥미진진한 때랍니다!

    statement#history
      text.
        #[span.highlight #{localizedHouseNames[worldState.playerHouse]} 기숙사]를 선택한 것을 축하합니다!<br><br>
        호퍼 온실이 지금까지 기숙사 대항전의 첫 무대가 된 적이 한 번도 없다는 사실을 알고 있나요?
        대항전을 시작할 기숙사는 언제나 완전히 무작위로 정해집니다.
        올해는 어느 기숙사가 뽑힐지 궁금하군요!

    statement#gauntlet_default
      text.
        이런, 일이 예상치 못한 방향으로 흘러가는군요! 대항전 선수가 사라진 일 말이에요.
        러브레이스 기숙사에서 대항전을 시작하는 건… 전에도 여러 번 있었지만요!
        그럼 러브레이스 탑으로 가는 편이 좋겠군요. 러브레이스 기숙사의 과제에 행운을 빕니다, 오퍼레이터!

    statement#getting_started
      text.
        행운을 빕니다, 오퍼레이터!

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
