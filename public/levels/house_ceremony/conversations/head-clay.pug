-
  const STATE_KEY = 'TQ_HOUSE_CEREMONY_WORLD_STATE';
  const worldState = getState(STATE_KEY);
  const localizedHouseNames = { lovelace: '러브레이스', turing: '튜링', neumann: '폰 노이만', hopper: '호퍼' };

mixin unique
  response#unique.
    러브레이스 기숙사만의 특징이 무엇이었는지 다시 알려 주시겠어요?

mixin join
  response#join.
    러브레이스 기숙사에 들어가고 싶습니다!

mixin deciding
  response#deciding.
    어느 기숙사에 들어갈지 아직 고민 중입니다.

mixin getting_started
  response#getting_started.
    그곳에서 뵙겠습니다!

conversation(display_name="러브레이스 기숙사 책임자 클레이 교수")
  case lastResponse

    when "unique"
      statement#unique
      responses
        +join
        +deciding

    when "join"
      statement#join

    when "deciding"
      statement#deciding

    when "getting_started"
      statement#getting_started

    default
      if !worldState.playerHouse
        statement#default
        responses
          +unique
          +join
          +deciding

      else if worldState.playerHouse && !worldState.heapsortConversationHasEnded
        statement#history

      else if worldState.playerHouse && worldState.heapsortConversationHasEnded
        statement#gauntlet_default
        responses
          +getting_started

  statements
    statement#default
      text.
        기숙사 배정식에 온 것을 환영합니다, 오퍼레이터.
        러브레이스 기숙사에 들어오기로 결정했나요?

    statement#unique
        text.
          러브레이스 기숙사는 예술가의 기숙사로 알려져 있습니다.
          이곳에서는 코드의 아름다움과 예술뿐 아니라 문서 작성의 예술도 탐구하죠.

    statement#join
        text.
          정말 기쁜 소식이군요. 선택을 확정하려면
          서약 두루마리를 들고 #[span.highlight 기숙사 불꽃]으로 가세요.

    statement#deciding
        text.
          충분히 이해합니다, 오퍼레이터. 중요한 결정이니까요!

    statement#history
        text.
          #[span.highlight #{localizedHouseNames[worldState.playerHouse]} 기숙사]를 선택하다니 훌륭합니다, 오퍼레이터.<br><br>
          이제 곧 어느 기숙사에서 대항전을 시작할지 알게 될 겁니다. 순서는 무작위로 정하지만
          행운은 늘 러브레이스 기숙사의 편인 듯하죠.
          이번에도 러브레이스 탑에서 대항전을 시작하게 될지 누가 알겠어요!

    statement#gauntlet_default
      text.
        사라진 대항전 선수를 찾는 동안 기숙사 대항전에 참가해 주기로 해서 고맙습니다, 오퍼레이터.
        그래도 걱정하지 마세요. 신나는 과제들이 기다리고 있으니까요.
        제 생각에는 러브레이스 기숙사만큼 대항전을 시작하기 좋은 곳도 없답니다.<br><br>
        러브레이스 탑을 즐겁게 탐험하길 바랍니다! 다음 안내를 받을 준비가 되면
        탑에서 다시 만나요.

    statement#getting_started
      text.
        온 힘을 다해 응원하겠습니다!

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
