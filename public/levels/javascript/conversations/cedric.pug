- const worldState = getState('TQ_JAVASCRIPT_WORLD_STATE');

// Responses
mixin what_research
  response#what_research.
    이곳에서는 어떤 연구가 진행 중인가요?

mixin what_can_i_learn
  response#what_can_i_learn.
    이 연구소에서는 JavaScript에 대해 무엇을 배울 수 있나요?

conversation(display_name="세드릭(Cedric)")
  - const savedDay = worldState && Object.values(worldState.room1_split.lasers).every(isOn => isOn);
  - const pleaseHurry = worldState && worldState.room1 && worldState.room1.explosionTriggered;
  if savedDay
    statement#saved_day
  else if pleaseHurry
    statement#please_hurry
  else
    case lastResponse
      when "what_research"
        statement#what_research
        responses
          +what_can_i_learn

      when "what_can_i_learn"
        statement#what_can_i_learn
        responses
          +what_research

      default
        statement#default
        responses
          +what_can_i_learn
          +what_research

  statements
    statement#saved_day
      text.
        실험실 폭발로 발생했던 차원 균열이 제거된 것으로 보입니다. 정말 잘하셨습니다! 당신이라면 해낼 줄 알았습니다.
      speech
        prosody(rate="110%").
          실험실 폭발로 발생했던 차원 균열이 제거된 것으로 보입니다. 정말 잘하셨습니다! 당신이라면 해낼 줄 알았습니다.

    statement#please_hurry
      text.
        오퍼레이터 - 첩보에 따르면 실험실 폭발로 인한 #[span.red 차원 균열(dimensional rift)]이 아직도 확장되고 있습니다.<br/><br/>오른쪽 방에 있는 #[span.highlight 수석 연구원과 협력]하십시오. 그녀가 현재 해결책을 찾고 있습니다.
      speech
        prosody(rate="110%").
          오퍼레이터. 첩보에 따르면 실험실 폭발로 인한 차원 균열이 아직도 확장되고 있습니다. 오른쪽 방에 있는 수석 연구원과 협력하십시오. 그녀가 현재 해결책을 찾고 있습니다.

    statement#what_can_i_learn
      text.
        연구소를 탐험하려면 JavaScript 프로그래밍 언어에 익숙해져야 합니다. 이 과정에서 컴퓨터에 #[a(href="https://www.nodejs.org") Node.js] JavaScript 런타임을 설치하게 되며, 이를 통해 JavaScript 코드를 직접 작성하고 실행할 수 있게 될 것입니다.
      speech
        prosody(rate="110%").
          연구소를 탐험하려면 JavaScript 프로그래밍 언어에 익숙해져야 합니다. 이 과정에서 컴퓨터에 Node JS JavaScript 런타임을 설치하게 되며, 이를 통해 JavaScript 코드를 직접 작성하고 실행할 수 있게 될 것입니다.

    statement#what_research
      text.
        현재 연구팀은 새롭게 발견된 원소인 #[span.highlight 오리타이피움(ducktypium)]의 에너지 생성 특성을 연구하고 있습니다. 우리는 이 원소가 JavaScript의 힘의 근원이라고 믿고 있습니다. 우측의 보안 장벽을 통과하여 우리의 연구 데이터를 직접 확인해 보십시오.
      speech
        prosody(rate="110%").
          현재 연구팀은 새롭게 발견된 원소인 오리타이피움의 에너지 생성 특성을 연구하고 있습니다. 우리는 이 원소가 JavaScript의 힘의 근원이라고 믿고 있습니다. 우측의 보안 장벽을 통과하여 우리의 연구 데이터를 직접 확인해 보십시오.

    statement#default
      text.
        오퍼레이터 - 이곳 #[span.highlight JavaScript 테스트 연구소(JavaScript Test Lab)]의 작업을 참관하러 와주셔서 기쁩니다. TwilioQuest 과학자들은 JavaScript 프로그래밍 언어의 잠재력을 끌어내는 데 상당한 진전을 보이고 있습니다.
      speech
        prosody(rate="110%").
          오퍼레이터. 이곳 JavaScript 테스트 연구소의 작업을 참관하러 와주셔서 기쁩니다. TwilioQuest 과학자들은 JavaScript 프로그래밍 언어의 잠재력을 끌어내는 데 상당한 진전을 보이고 있습니다.
