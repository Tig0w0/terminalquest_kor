-
  // After conversation happens once, Operator gets green card
  const STATE_KEY = 'TQ_JAVASCRIPT_WORLD_STATE';
  const worldState = getState(STATE_KEY) || {};

// Responses
mixin security_tight
  response#security_tight.
    이 우주 정거장의 보안이 꽤 삼엄한 것 같은데, 이유가 뭔가요?

mixin about
  response#about.
    이 정거장에서 어떤 연구를 진행 중인가요?

conversation(display_name="TwilioQuest 과학자")
  case lastResponse
    when "about"
      statement#about
      responses
        +security_tight

    when "security_tight"
      statement#security_tight
      responses
        +about

    default
      if worldState.accessLevels && worldState.accessLevels.green
        statement#default_alt
      else
        statement#default
      responses
        +security_tight
        +about

  statements

    statement#security_tight
      text.
        JavaScript가 세계에서 가장 많이 쓰이는 프로그래밍 언어이긴 하지만, 이 정거장에서
        우리가 하는 일은 단순히 DOM 요소의 표시 여부를 전환하는 것보다 훨씬 심오합니다.
        우리는 클라우드라는 가상 우주를 어떻게 지탱하는지 이해하기 위해 언어의 기반 요소를
        대상으로 한 최첨단 연구를 진행하고 있습니다.<br/><br/>
        이 연구는 무척 중요하고 흥미롭지만, 그만큼 위험할 수도 있습니다. 따라서 고도의 훈련을
        받은 인원만 연구에 참여할 수 있도록 보안을 통제해야만 합니다.

    statement#about
      text.
        현재 진행 중인 프로젝트가 많지만, 가장 완성 단계에 이른 것은 JavaScript의 핵심
        구성 요소 중 하나인 '덕타이피움(Ducktypium)'에 대한 연구입니다. 저희 연구팀은 진정으로 폭발적인
        결과를 내기 직전입니다.<br/><br/>
        이 프로젝트를 한 번 확인해 보셔야 합니다! 녹색 체크포인트를 통과하면
        북쪽 연구 모듈로 가보세요. 그것이 현재 소지하신 키카드로 들어갈 수 있는
        유일한 연구실 모듈입니다.

    statement#default_alt
      text.
        오퍼레이터님, 안녕하세요! 보안 시스템 점검을 도와주셔서 감사합니다!

    statement#default
      text.
        오퍼레이터님, 환영합니다! JavaScript 테스트 연구소에 오신 것을 환영합니다!
        당신을 기다리고 있었습니다. 우리 보안 시스템을 점검하러 오셨다고 들었는데요?<br/><br/>
        우선 작업을 시작할 수 있도록 #[span.highlight 녹색 키카드(green keycard)]를 하나 지급해 드리겠습니다.
        이 카드가 있으면 메인 중앙홀과 덕타이피움(Ducktypium) 연구 모듈에 접근하실 수 있습니다.

-
  // After conversation happens once, Operator gets green card
  const newWorldState = {
    ...worldState,
    accessLevels: { ...worldState.accessLevels, green: { opened: [] } }
  }
  setState(STATE_KEY, newWorldState);
