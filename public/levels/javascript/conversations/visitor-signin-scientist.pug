-
  // After conversation happens once, Operator gets green card
  const STATE_KEY = 'TQ_JAVASCRIPT_WORLD_STATE';
  const worldState = getState(STATE_KEY) || {};

// Responses
mixin security_tight
  response#security_tight.
    우주 정거장의 보안이 꽤 삼엄해 보이는데 - 이유가 뭔가요?

mixin about
  response#about.
    이 우주 정거장에서는 어떤 종류의 연구를 진행하고 있나요?

conversation(display_name="TwilioQuest 연구원")
  case lastResponse
    when "about"
      statement#about
      responses
        +security_tight

    when "security_tight"
      statement#security_tight
      responses
        +about

    default
      if worldState.accessLevels && worldState.accessLevels.green 
        statement#default_alt
      else
        statement#default
      responses
        +security_tight
        +about

  statements
    
    statement#security_tight
      text.
        JavaScript가 세계에서 가장 널리 사용되는 프로그래밍 언어이긴 하지만, 이곳 우주 정거장에서 저희가 수행하는 작업은 단순히 DOM 요소의 가시성을 조작하는 것보다 훨씬 심도 깊은 일입니다. 저희는 The Cloud의 가상 우주를 어떻게 지탱할 수 있는지 이해하기 위해 언어의 근본적인 요소들에 대한 최첨단 연구를 진행하고 있습니다.<br/><br/>
        필수적이고 흥미진진한 연구이지만, 동시에 매우 위험할 수도 있습니다. 따라서 훈련된 직원만이 연구에 참여할 수 있도록 확실히 통제해야 합니다.

    statement#about
      text.
        수많은 프로젝트가 진행 중이지만, 가장 성숙한 단계에 있는 프로그램은 JavaScript의 필수 구성 요소 중 하나인 오리타이피움(Ducktypium) 연구입니다. 저희 연구팀은 진정으로 폭발적인 결과가 나오기 직전 단계에 도달했습니다.<br/><br/>
        당신도 이 프로젝트를 확인해 보셔야 해요! 초록색(green) 체크포인트를 통과한 후, 북쪽의 연구 모듈로 이동하세요. 현재 소지하신 키카드(keycard)로 접근할 수 있는 유일한 실험실 모듈일 겁니다.

    statement#default_alt
      text.
        안녕하세요 오퍼레이터! 저희 보안 시스템 점검을 도와주셔서 감사합니다!

    statement#default
      text.
        안녕하세요, 오퍼레이터! JavaScript 테스트 연구소(JavaScript Test Lab)에 오신 것을 환영합니다! 계속 기다리고 있었습니다. 저희 보안 시스템을 점검하러 오셨다고 들었는데요?<br/><br/>
        시작하실 수 있도록 #[span.highlight 초록색 키카드(green keycard)]를 하나 제공해 드리겠습니다. 이걸로 메인 중앙 홀과 오리타이피움 연구 모듈에 접근하실 수 있을 겁니다.

-
  // After conversation happens once, Operator gets green card
  const newWorldState = {
    ...worldState,
    accessLevels: { ...worldState.accessLevels, green: { opened: [] } }
  }
  setState(STATE_KEY, newWorldState);
