- const worldState = getState('TQ_JAVASCRIPT_WORLD_STATE');

mixin yes_cant_see
  response#yes_cant_see.
    네, 하지만 안 보이는데요... 대체 무슨 일이죠?

mixin how_do_that
  response#how_do_that.
    육체를 잃어버리다니 끔찍하군요... 제가 어떻게 도와드리면 될까요?

mixin need_key
  response#need_key.
    수석 연구원이 오리타이피움 실험실의 레이저 활성화 코드를 가져와 달라고 하셨습니다. 혹시 가지고 계신가요?

conversation(display_name="TwilioQuest 물리학자")
  if lastResponse === "yes_cant_see"
    statement.
      다행이네요, 드디어 제가 아직 여기 있다는 걸 알아챈 사람이 나타났군요! 오리타이피움 폭발 때문에 이 물질 구체화기(matter instantiator)가 오작동을 일으켰어요. 기계를 안정화시키려다 실수로 작동해버리는 바람에 #[span.highlight 제 육체가 다중 우주의 이 차원에서 위상을 벗어나 버렸습니다]!<br/><br/>
      이 현상 이면에 숨겨진 과학적 원리는 사실 꽤 매혹적이지만, 괜찮으시다면 제 육체를 정상으로 되돌려 주신 후에 그 이야기를 나누고 싶군요.
    responses
      +how_do_that
      +need_key
  
  else if lastResponse === "how_do_that"
    statement.
      이 챔버 동쪽과 서쪽 복도에 제어 단말기들이 있습니다 - 폭발 당시 손상되었을 거예요. 그 #[span.highlight 단말기들을 다시 온라인 상태로 복구]해 주신다면, 물질 구체화기가 제 육체를 다시 조립할 수 있을 겁니다.
    responses
      +need_key

  else if lastResponse === "need_key"
    statement.
      가지고 있긴 한데, 제 하드웨어 키(key) 역시 제 육체와 마찬가지로 위상을 벗어나 버렸습니다. #[span.highlight 제 육체를 원래대로 복구]시켜 주시면 활성화 코드를 드리죠.
    responses
      +how_do_that

  else if worldState.northWing.summonAnimFinished
    if worldState.northWing.hadSavedConversation
      statement.
        #[span.highlight 제 육체를 원래대로 복구]시켜 주셔서 다시 한 번 감사드립니다. 실험실 북쪽 레이저를 위한 #[span.highlight 활성화 코드를 이미 받으셨으니] 잠시 후 저도 그쪽으로 가겠습니다.
      responses
    else
      - worldState.northWing.hadSavedConversation = true;
      statement.
        잠깐... 제가 보이나요? 제가 보이는군요! 해내셨어요, #[span.highlight 제 육체를 복구]시켜 주셨어요!<br/><br/> 자 - 여기 실험실 북쪽 레이저를 위한 #[span.highlight 제 활성화 코드를 받으세요]. 저도 잠시 후 그쪽으로 가겠습니다. 먼저 제 내부 장기들이 제대로 재조립되었는지 확실히 확인해 봐야 할 것 같아요. 그리고 분명히 키가 몇 인치 더 컸던 것 같은데...
      responses

  else if worldState.northWing.hadIntroConversation
    statement.
      여보세요? 아직 제 목소리 들리나요? #[span.highlight 제 육체를 원래대로 복구]시켜 주신다면 필요하신 활성화 코드를 기꺼이 내어 드리겠습니다.
    responses
      +how_do_that
      +need_key

  else
    - worldState.northWing.hadIntroConversation = true;
    statement.
      도와주세요! 도와주세요! 제 말 들리나요?!?!
    responses
      +yes_cant_see

// Flush world state changes, if any
- setState('TQ_JAVASCRIPT_WORLD_STATE', worldState);
