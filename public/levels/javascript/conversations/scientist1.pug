- const worldState = getState('TQ_JAVASCRIPT_WORLD_STATE');

mixin how_get_job
  response#how_get_job.
    매우 중요한 프로젝트인 건 알겠는데, 어쩌다 이런 연구를 하게 되신 건가요?

conversation(display_name="TwilioQuest 과학자")
  if lastResponse === "how_get_job"
    statement.
      분자 생물학 박사 학위를 딴 뒤에 제가 이런 일을 하게 될 줄은 상상도 못 했습니다. 그리고 제약 회사에서 제시한 연봉에 비하면 턱없이 부족한 수준이라는 것도 말씀드릴 수 있죠.<br/><br/>하지만 저는 미스터리를 풀어낼 기회를 거부해본 적이 없어요. TwilioQuest 프로그램 측에서 제게 미지의 물질을 연구해달라고 제안해 왔는데, 어떻게 거절할 수 있었겠어요?
    responses
      response#lucky_to_have.
        이곳에서 당신과 일하게 되어 행운이겠네요.

  else if lastResponse === "lucky_to_have"
    statement.
      틀린 말은 아니죠 ;)<br/><br/>그리고 오퍼레이터님이 도와주셔서 저희 역시 다행이라고 생각합니다. 그럼 다시 일하러 가볼까요?

  else if lastResponse === "what_happened"
    include scientist1_disaster.pug

  else if worldState.room1.explosionTriggered
    if lastResponse
      include scientist1_disaster.pug
    else if worldState.scientistDisasterConvo
      statement.
        폭발로 인해 생긴 #[span.red 차원의 균열]이 갈수록 심각해지고 있습니다. 제가 복구할 수 있을 것 같긴 한데, 그러려면 #[span.highlight 이 방에 있는 정지 광선들을 다시 가동]해야 합니다.<br/><br/>연구소 곳곳에 고립된 #[span.highlight 제 동료들을 찾아주세요]. 그들이 광선을 다시 가동하는 데 필요한 활성화 코드를 가지고 있을 겁니다. 서두르면 아직 이 상황을 해결할 수 있습니다.
      responses
        response#what_happened.
          무슨 일이 일어났던 건지 한 번만 더 설명해 주시겠어요? 구체적으로, 연구소 절반이 날아가고 온통 불바다가 된 그 부분 말이에요.
    else
      statement.
        상황이 안 좋습니다. 아주, 정말로 안 좋아요.
      responses
        response#what_happened.
          어... 네. 연구소 절반이 사라졌고 모든 곳이 불타고 있으니까요! 대체 무슨 일이 있었던 거죠?

  else
    if worldState.room1.passwordFound
      statement.
        #[span.highlight 정지 광선 비밀번호]를 찾으셨군요! 정말 최고예요! <br/><br/> 대규모 실험을 다시 시작하는 영광은 당신이 차지하는 게 맞겠네요. #[span.highlight 방 중앙의 광선 제어 장치로 가서] 비밀번호를 입력해 주세요. 정말 흥분되네요! 곧 JavaScript의 '빅뱅'과 같은 순간을 발견하게 될 거예요!
      responses
        +how_get_job

    else if worldState.room1.scientistInitalConvo
      statement.
        이 방 중앙에 있는 정지 광선의 #[span.highlight 비밀번호를 찾아주겠다고] 해주셔서 다시 한번 감사드립니다. 비밀번호를 찾고 나면 #[span.highlight 덕타이피움 연구를 계속]할 수 있을 거예요! <br/><br/>제 뒤에 있는 보안 장벽들을 통과하시면, #[span.highlight 제 책상 위 종이 조각에 비밀번호가 적혀 있을 겁니다].
      responses
        +how_get_job

    else
      include scientist1_initial.pug

// Flush world state changes, if any
- setState('TQ_JAVASCRIPT_WORLD_STATE', worldState);
