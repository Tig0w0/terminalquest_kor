- const worldState = getState('TQ_JAVASCRIPT_WORLD_STATE');

mixin how_get_job
  response#how_get_job.
    매우 중요한 프로젝트라는 건 알겠는데 - 어쩌다 이런 연구를 맡게 되신 건가요?

conversation(display_name="TwilioQuest 연구원")
  if lastResponse === "how_get_job"
    statement.
      분자생물학 박사 학위를 받은 후 이런 일을 하게 될 줄은 저도 상상조차 못 했습니다. 제약 회사에서 받았던 제안에 비하면 보수도 형편없죠.<br/><br/>하지만 전 미스터리를 풀 기회를 절대 거절하지 못하거든요. TwilioQuest 프로그램이 이전에 알려지지 않았던 미지의 물질을 연구해 달라고 영입을 제안했을 때, 어떻게 거절할 수 있었겠어요?
    responses
      response#lucky_to_have.
        그곳도 당신을 영입한 건 행운이네요.

  else if lastResponse === "lucky_to_have"
    statement.
      틀린 말은 아니죠 ;)<br/><br/>그리고 저희도 당신의 도움을 받게 된 건 큰 행운이라고 말하고 싶네요. 자, 다시 본론으로 돌아가 볼까요?

  else if lastResponse === "what_happened"
    include scientist1_disaster.pug
  
  else if worldState.room1.explosionTriggered
    if lastResponse
      include scientist1_disaster.pug
    else if worldState.scientistDisasterConvo
      statement.
        폭발로 인해 생긴 #[span.red 차원 균열(dimensional rift)]이 점점 악화되고 있어요. 제가 되돌릴 수 있을 것 같긴 한데, 그러려면 먼저 #[span.highlight 이 방에 있는 빔(beam)들을 다시 가동]해야 합니다.<br/><br/>연구소 곳곳에 고립된 #[span.highlight 제 동료들을 찾아주세요]. 빔을 다시 가동하는 데 필요한 활성화 코드를 그들이 가지고 있을 겁니다. 빨리 움직인다면 아직 바로잡을 수 있어요.
      responses
        response#what_happened.
          무슨 일이 있었던 건지 다시 한 번 설명해 주시겠어요? 특히 실험실 절반이 날아가고 모든 게 불타고 있는 그 부분이요?
    else
      statement.
        상황이 안 좋아요. 정말 아주 안 좋습니다.
      responses
        response#what_happened.
          어, 네 - 실험실 절반이 날아가고 모든 게 불타고 있으니까요! 대체 무슨 일이 일어난 건가요?

  else
    if worldState.room1.passwordFound
      statement.
        #[span.highlight 정지 빔(stasis beam) 비밀번호]를 찾아내셨군요! 당신이 최고예요! <br/><br/> 당신이 직접 우리의 거대한 실험을 재가동하는 게 맞겠네요. #[span.highlight 방 중앙에 있는 빔 제어 장치로 가서] 그 비밀번호를 입력해 주세요. 너무 흥분되네요 - 분명 JavaScript의 "빅뱅" 순간을 발견하게 될 거예요!
      responses
        +how_get_job

    else if worldState.room1.scientistInitalConvo
      statement.
        방 중앙에 있는 정지 빔의 #[span.highlight 비밀번호를 찾는 걸] 도와주셔서 정말 감사합니다. 그걸 찾으면 우리의 #[span.highlight 오리타이피움 연구를 재개]할 수 있어요! <br/><br/>제 뒤에 있는 보안 장벽을 통과하면, #[span.highlight 내 책상 위 종이 조각에 정지 빔의 비밀번호]가 적혀 있을 겁니다.
      responses
        +how_get_job

    else
      include scientist1_initial.pug

// Flush world state changes, if any
- setState('TQ_JAVASCRIPT_WORLD_STATE', worldState);
