- const worldState = getState('TQ_JAVASCRIPT_WORLD_STATE');

mixin welcome
  response#welcome.
    제가 할 수 있는 일이었는걸요.

mixin follow_up
  response#follow_up.
    몸은 좀 괜찮으신가요? 최근에 겪은 일치고는 시공간의 왜곡을 좀 과하게 겪으신 것 같은데요.

conversation(display_name="TwilioQuest 물리학자")
  if lastResponse === "welcome"
    statement.
      하, 그건 아닐걸요. 시공간을 플레이도우(Play Doh) 찰흙 주무르듯 조작하는 걸 즐기신다면 모를까. 솔직히 말하자면, 그건 *제* 취향에 가깝죠.

    responses
      +follow_up

  else if lastResponse === "follow_up"
    statement.
      몸은 괜찮아요. 다만 이 모든 일이 시작되기 전에는 분명 제 눈동자가 갈색이었던 것 같은데 지금은 99% 확신할 수 없게 되었네요. 참고하려고 어머니께 아기 때 사진을 보내달라고 부탁해 두긴 했지만, 사실 별로 상관없어요. 이 기술의 응용 가능성은 정말 엄청날 테니까요!<br/><br/> 어쨌든 여기저기 부딪히고 멍들긴 했어도 당신 덕분에 몸은 온전하게 살아남았습니다.

    responses
      +welcome

  else
    statement.
      #[span.highlight 오리타이피움] 분자가 안정화되었어요! 당신이 The Cloud와 우리 모두를 구했을 뿐만 아니라, 우리가 JavaScript의 미스터리를 푸는 데 한 걸음 더 다가갈 수 있게 해 주었습니다. 당신은 전설이에요, 정말.

    responses
      +welcome
      +follow_up

// Flush world state changes, if any
- setState('TQ_JAVASCRIPT_WORLD_STATE', worldState);
