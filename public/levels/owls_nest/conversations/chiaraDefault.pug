- const STATE_KEY = 'com.twilioquest.owls_nest';
- const worldState = getState(STATE_KEY);

mixin relieved
  response#relieved.
    제가 클라우드에 무사히 들어온 걸 보고 안도하신 것 같은데요...

mixin get_started
  if worldState.movementSwitch
    response#understood.
      보안 파일런을 해제했습니다. 이제 무엇을 하면 되죠?
  else
    response#get_started.
      중요한 임무를 위해 이곳으로 오라는 지시를 받았습니다. 시작할까요?

conversation(display_name="키아라")
  case lastResponse
    when "relieved"
      statement#relieved
      responses
        response#fish.
          ...생선 냄새요?

    when "fish"
      statement#tell_right_away
      responses
        +get_started

    when "who_are_you"
      statement#chiara
      responses
        +relieved
        +get_started

    when "get_started"
      statement#get_started
      responses
        response#letsgo.
          알겠습니다. 무엇을 하면 되나요?

    when "letsgo"
      statement#test_motor
      responses
        response#understood.
          이해했습니다. 스위치를 켠 다음에는요?

    when "understood"
      statement#keep_moving
      responses
        +relieved

    default
      if !worldState.chiaraInitialGreeting
        - worldState.chiaraInitialGreeting = true;
        statement#default
        responses
          response#who_are_you.
            적어도 나쁜 상황보다는 낫겠죠. 그런데 아직 서로 소개하지 않은 것 같네요?
          +get_started

      else
        statement#follow_up_greeting
        responses
          response#who_are_you.
            누구시고 여기서는 무슨 일을 하는지 다시 알려 주시겠어요?
          +get_started

  statements
    statement#default
      text.
        신경 인터페이스 안정적... 모든 생체 신호 정상 범위.
        여기 살아서 도착하셨군요! 정말 멋지지 않나요!

    statement#follow_up_greeting
      text.
        안녕하세요, !{settings.name} 님! 몸은 괜찮으신가요? 도와드릴 일이 있나요?

    statement#chiara
      text.
        아, 맞아요. 물론 소개해야죠. 저는 TerminalQuest 프로그램의 의무 책임자
        <span class="highlight">키아라</span>입니다. 지금 여러분이 클라우드를
        경험하는 데 사용하는 새로운 신경 인터페이스를 설계했죠.<br/><br/>
        언제 만났더라도 반가웠겠지만 오늘은 특히 더 감격스럽군요. 이 버전의
        인터페이스가 제대로 작동할지 확신할 수 없었거든요!

    statement#relieved
      text.
        제가 그랬나요? 아니에요. 신경 인터페이스는 틀림없이 완전히 안전합니다.<br/><br/>
        그건 그렇고, 혹시 생선 냄새가 나지는 않나요?

    statement#tell_right_away
      text.
        참 엉뚱한 질문이죠. 냄새가 날 리가 있나요? 이 근처에는 생선이 전혀
        없으니까요!<br/><br/>하지만 생선 냄새가 나기 시작하면 즉시 제게
        알려야 합니다. 이해했나요? 좋아요. 아주 좋아요.

    statement#keep_moving
      text.
        의무실 문을 지나 기술 연구실로 가세요. 다음에는 마거릿이 당신과
        이야기하려 할 겁니다. 클라우드를 탐험할 때 필요한
        <span class="highlight">중요한 도구</span>를 지급해 줄 거예요.
        행운을 빕니다!

    statement#test_motor
      text.
        <span class="highlight">기본 이동 및 상호작용 조작법</span>을 사용해
        의무실 출구 근처의 스위치를 켜 주세요. 성공하면 신경 인터페이스가
        올바르게 설정되었다고 확신할 수 있습니다.<br/><br/>
        <span class="highlight">방향키 또는 W, A, S, D 키</span>로 아바타를
        움직일 수 있습니다. 스위치 같은 물체와 상호작용할 때는
        <span class="highlight">스페이스바</span>를 누르세요.

    statement#get_started
      text.
        그렇습니다. 수천 명의 오퍼레이터 가운데 당신이
        <span class="highlight">포그 아울(Fog Owl)</span>이라 부르는 시제
        클라우드 탐사선의 지휘관으로 선발되었습니다. 포그 아울에는 수년간의
        연구와 수십억 달러 규모의 최첨단 기술이 집약되어 있죠. 무엇보다도
        마침내 레거시 시스템보다 한발 앞서 나가게 해 줄 수 있습니다.<br/><br/>
        하지만 그런 일을 걱정하기 전에 먼저 기본적인 신체 운동 기능을 확인하고
        임무 수행에 적합한 상태인지 점검해야 합니다.

// Flush world state changes, if any
- setState(STATE_KEY, worldState);
