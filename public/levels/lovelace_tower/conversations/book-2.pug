-
  const STATE_KEY = 'TQ_LOVELACE_TOWER_WORLD_STATE';
  const worldState = getState(STATE_KEY);

mixin excerpt
  response#excerpt.
    책의 발췌문 읽기

conversation(display_name="러브레이스 장서 제2권")
  case lastResponse
    when "excerpt"
      statement#excerpt
    default
      statement#default
      responses
        +excerpt

  statements
    statement#default
      text.
        <p style="text-align:center">
        <span class="highlight">
        <a href="https://sci-hub.ru/https://dl.acm.org/doi/fullHtml/10.1145/2896587">API 사용성 개선하기</a>
        </span>
        <br><br>
        Brad A. Myers, Jeffrey Stylos 지음</p>

    statement#excerpt
      text.
        “사용성 문제를 API 자체에서 제거할 수 없더라도 사용자를 돕기 위한 여러 완화책을 적용할 수 있다.
        가장 분명한 방법은 문서와 예제 코드를 개선하는 것이다. 이는 일반적으로 API 사용자가 자주 불만을 제기하는 부분이다.
        <span class="highlight">API 설계자는 알려진 문제의 해결책으로 사용자를 명확하게 안내하도록 주의를 기울일 수 있다…</span>”(68쪽)

- setState(STATE_KEY, worldState);
